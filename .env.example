# Set to True for local development, False for production
DEBUG=True

# Set your allowed hosts
localhost,127.0.0.1,.ngrok-free.app,.ngrok-free.dev

# API Settings
HUME_API_KEY=your_humpe_api_key_here
HUME_SECRET_KEY=your_humpe_secret_key_here